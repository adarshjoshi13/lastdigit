{
  "appId": "com.lastdigit.lottery",
  "appName": "Last Digit",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "allowNavigation": []
  },
  "android": {
    "backgroundColor": "#0f0f13",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0f0f13",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0f0f13"
    }
  }
}
